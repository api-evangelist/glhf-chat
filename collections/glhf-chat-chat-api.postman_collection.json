    "_postman_id": "fbbff18e-ab10-4e19-b744-fc80732a15c9",
    "name": "glhf Chat API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "OpenAI-compatible REST API for glhf (glhf.chat), a platform that runs almost any open-source large language model on demand. Models are selected by passing a Hugging Face repository identifier as hf:org/model. Only the endpoints documented for the glhf OpenAI-compatible surface are described here.\n\nContact Support:\n Name: glhf",
      "type": "text/plain"
    }
